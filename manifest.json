{
  "manifest_version": 3,
  "name": "Twitch Chat Translator",
  "version": "0.3.0",
  "description": "Translates live Twitch chat on your device with Chrome's built-in translator, or with DeepL.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Twitch Chat Translator",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": [
        "src/shared/settings.js",
        "src/content/dom.js",
        "src/content/local-engine.js",
        "src/content/deepl-engine.js",
        "src/content/pipeline.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
